{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "Football League Data",
    "type": "object",
    "required": [
        "teams",
        "players",
        "matches"
    ],
    "properties": {
        "teams": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "logo": {
                        "type": "string",
                        "description": "Path to team logo image"
                    }
                },
                "additionalProperties": false
            }
        },
        "players": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "teamId": {
                        "type": "integer",
                        "description": "ID of the team the player belongs to"
                    },
                    "image": {
                        "type": "string",
                        "description": "Path to player image"
                    },
                    "hidden": {
                        "type": "boolean",
                        "description": "If true, player identity is not shown"
                    },
                    "topScorerMonths": {
                        "type": "array",
                        "description": "Months when the player finished as top scorer",
                        "items": {
                            "type": "string"
                        },
                        "uniqueItems": true
                    },
                    "attributes": {
                        "type": "object",
                        "properties": {
                            "pace": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 99
                            },
                            "shooting": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 99
                            },
                            "passing": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 99
                            },
                            "dribbling": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 99
                            },
                            "defending": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 99
                            },
                            "physical": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 99
                            },
                            "goalkeeping": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 99
                            },
                            "position": {
                                "type": "string",
                                "enum": [
                                    "GK",
                                    "DEF",
                                    "MID",
                                    "FWD",
                                    "ST"
                                ]
                            },
                            "secondaryPosition": {
                                "oneOf": [
                                    {
                                        "type": "string",
                                        "enum": [
                                            "GK",
                                            "DEF",
                                            "MID",
                                            "FWD",
                                            "ST"
                                        ]
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "overall": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 99
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        },
        "matches": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "date",
                    "teams"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "date": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "poster_filename": {
                        "type": "string",
                        "description": "Filename of the matchday poster stored in the R2 matchday-posters directory.",
                        "examples": [
                            "august-15.png",
                            "august-8.png",
                            "july-25.png"
                        ]
                    },
                    "motmPlayerId": {
                        "description": "Man of the Match player ID",
                        "oneOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "teams": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                            "type": "object",
                            "required": [
                                "teamId",
                                "score"
                            ],
                            "properties": {
                                "teamId": {
                                    "type": "integer"
                                },
                                "score": {
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "captainPlayerId": {
                                    "type": "integer",
                                    "minimum": 1
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "lineup": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                            "type": "object",
                            "required": [
                                "teamId",
                                "playerIds"
                            ],
                            "properties": {
                                "teamId": {
                                    "type": "integer"
                                },
                                "playerIds": {
                                    "type": "array",
                                    "items": {
                                        "type": "integer"
                                    },
                                    "description": "List of player IDs in this team's lineup"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "goals": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "playerId",
                                        "teamId",
                                        "count"
                                    ],
                                    "properties": {
                                        "playerId": {
                                            "type": "integer"
                                        },
                                        "teamId": {
                                            "type": "integer"
                                        },
                                        "count": {
                                            "type": "integer",
                                            "minimum": 1
                                        },
                                        "penaltiesCount": {
                                            "type": "integer",
                                            "minimum": 0
                                        },
                                        "ownGoal": {
                                            "type": "boolean",
                                            "description": "If true, this was an own goal"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            }
                        ]
                    }
                },
                "additionalProperties": false
            }
        },
        "awards": {
            "type": "object",
            "description": "Monthly player awards",
            "patternProperties": {
                "^\\d{4}-(0[1-9]|1[0-2])$": {
                    "type": "object",
                    "properties": {
                        "ultimate-team": {
                            "type": "array",
                            "minItems": 7,
                            "maxItems": 7,
                            "uniqueItems": true,
                            "items": {
                                "type": "integer"
                            }
                        },
                        "top-scorer": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer"
                                },
                                "goals": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}